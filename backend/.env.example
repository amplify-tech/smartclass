# local | staging | production
DJANGO_ENV=local

SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated frontend origins
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Leave blank to use SQLite locally. Set for staging/production (and local Postgres).
DATABASE_URL=
# Or individual Postgres settings:
# DB_NAME=smartclass
# DB_USER=smartclass
# DB_PASSWORD=smartclass
# DB_HOST=localhost
# DB_PORT=5432
