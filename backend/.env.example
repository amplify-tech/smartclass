# local | staging | production
DJANGO_ENV=local

SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated frontend origins
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# PostgreSQL (required in every environment)
# Option A — connection URL:
# DATABASE_URL=postgres://smartclass:smartclass@localhost:5432/smartclass

# Option B — individual settings (defaults match postgresql.init):
DB_NAME=smartclass
DB_USER=smartclass
DB_PASSWORD=smartclass
DB_HOST=localhost
DB_PORT=5432

# S3-compatible object storage (django-storages)
# Optional for local: leave empty to store files under MEDIA_ROOT.
# Set all of these to use AWS S3 or an S3-compatible provider
# (e.g. Supabase Storage).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_ENDPOINT_URL=
AWS_S3_REGION_NAME=
AWS_S3_CUSTOM_DOMAIN=

# LLM — question generation (local = Ollama; gemini = Google AI)
LLM_PROVIDER=local
LLM_MODEL=qwen3:1.7b
LLM_BASE_URL=http://localhost:11434
# Required for gemini; unused for most local Ollama setups
LLM_API_KEY=abcd
